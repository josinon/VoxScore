# URL do PostgreSQL (ex.: stack local em ../docker-compose.yml)
DATABASE_URL=postgresql://voxscore:voxscore@localhost:5432/voxscore

# Pool de conexões por processo da API (TypeORM / pg). Em K8s: (réplicas × max) < max_connections do Postgres.
# DATABASE_POOL_MAX=20
# DATABASE_POOL_MIN=2

# Porta HTTP da API (opcional)
PORT=3000

# JWT (obrigatório para arrancar a API) — mínimo ~32 caracteres recomendado
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m

# Primeiro ADMIN (bootstrap quando não existe nenhum ADMIN na base)
BOOTSTRAP_ADMIN_EMAIL=admin@voxscore.local
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# Apenas desenvolvimento/CI: emite POST /api/v1/auth/dev/token — NUNCA true em produção
AUTH_DEV_TOKEN_ENABLED=false

# Mock de OAuth Google (POST /api/v1/auth/oauth/mock) — NUNCA true em produção
AUTH_GOOGLE_MOCK_ENABLED=false

# OAuth Google (produção / staging real). Callback deve coincidir com a consola Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Após login, redirecionar o browser para esta origem com fragment #access_token=<JWT>
# OMITIR = resposta JSON { accessToken } no callback (útil para testes manuais).
# OAUTH_FRONTEND_REDIRECT_URL=http://localhost:5173/oauth/callback

# CORS: lista separada por vírgulas (omitir = refletir pedidos ou política permissiva em dev)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Migrações ao arrancar: omitir ou `true` = aplica migrações pendentes (bom para local).
# `false` = não aplicar (use em K8s com várias réplicas + Job de migrate).
TYPEORM_MIGRATIONS_RUN=true

# OpenAPI / Swagger em `/api/v1/docs` (defina `false` para desligar)
# SWAGGER_ENABLED=false

# WebSocket: agrupa vários votos/publicações num único `ranking_changed` (ms). `0` = imediato.
# REALTIME_RANKING_DEBOUNCE_MS=1500

# Redis — cache de ranking e WebSocket entre várias réplicas da API (obrigatório em K8s multi-pod).
# REDIS_URL=redis://localhost:6379
# REDIS_REQUIRED=true

# Cache de GET /ranking (Redis quando REDIS_URL definido; senão memória local). `false` ou TTL `0` = desligado.
# RANKING_CACHE_ENABLED=true
# RANKING_CACHE_TTL_MS=3000

# Cache de candidato no POST /votes (active, votingOpen). Redis partilhado entre pods.
# VOTE_CANDIDATE_CACHE_ENABLED=true
# VOTE_CANDIDATE_CACHE_TTL_MS=8000

# Rate limit (Fase 10) — pedidos por IP dentro da janela `TTL` (ms)
# POST /api/v1/candidates/:id/votes
# THROTTLE_VOTES_LIMIT=30
# THROTTLE_VOTES_TTL_MS=60000
# POST /api/v1/auth/dev/token e POST /api/v1/auth/oauth/mock
# THROTTLE_AUTH_LIMIT=40
# THROTTLE_AUTH_TTL_MS=60000

# SSL do cliente Postgres (ex.: produção em nuvem)
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
