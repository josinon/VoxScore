# Copie para secrets.env e preencha valores reais:
#   cp secrets.env.example secrets.env
#
# secrets.env está no .gitignore — nunca faça commit desse ficheiro.
# POSTGRES_PASSWORD e a password em DATABASE_URL têm de ser iguais
# (URL-encode caracteres especiais na connection string).

POSTGRES_USER=voxscore
POSTGRES_PASSWORD=voxscore-in-k8s-change-me
POSTGRES_DB=voxscore

DATABASE_URL=postgresql://voxscore:voxscore-in-k8s-change-me@postgres:5432/voxscore
JWT_SECRET=k8s-with-postgres-change-me-use-at-least-32-chars
GOOGLE_CLIENT_ID=configure-or-use-mock-in-configmap
GOOGLE_CLIENT_SECRET=configure-or-use-mock-in-configmap
GOOGLE_CALLBACK_URL=https://megavoz.lab6.cloud/api/v1/auth/google/callback
OAUTH_FRONTEND_REDIRECT_URL=https://megavoz.lab6.cloud/oauth/callback
